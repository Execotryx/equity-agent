# Copy to backend/.env and fill in. backend/.env is gitignored - never commit it.

# --- Required -------------------------------------------------------------------------------
# Anthropic API key: https://platform.claude.com/settings/keys (paid per token; ~$0.12-0.15 per report)
ANTHROPIC_API_KEY=
# Tavily web search: https://app.tavily.com (free plan: 1,000 credits/month; <= 2 per report)
TAVILY_API_KEY=
# SEC EDGAR requires a contact identity on every request: "Your Name your.email@example.com"
EDGAR_IDENTITY=

# --- Optional: Claude model and effort per agent ---------------------------------------------
# Effort: low | medium | high | xhigh | max. Defaults below were chosen from measured latency
# (IMPLEMENTATION_PLAN.md section 2.2): output length and effort dominate Claude response time.
COMPS_MODEL=claude-opus-5-5
COMPS_EFFORT=low
RISK_MODEL=claude-opus-5-5
RISK_EFFORT=low
ANALYST_MODEL=claude-opus-5-5
ANALYST_EFFORT=low
# Sonnet 5.5 streams its first text in ~1 s; Opus 5.5 thinks first (~11 s).
WRITER_MODEL=claude-sonnet-5-5
WRITER_EFFORT=low

# --- Optional: server ------------------------------------------------------------------------
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# --- Optional: offline demo -------------------------------------------------------------------
# 1 = replay the recording in backend/demo/ (made by `uv run python -m equity_agent.evaluate --record`)
# instead of calling Yahoo, SEC, Tavily or Claude. Use it if the network fails during a demo.
DEMO_OFFLINE=0
# Offline model calls take this share of their recorded time (0 = instant).
DEMO_REPLAY_SPEED=0.4

# Read by the Python interpreter itself (keeps 10-K text from being garbled on Windows).
# `npm run dev:all` already sets it; set it in your shell too when running backend commands directly.
PYTHONUTF8=1
